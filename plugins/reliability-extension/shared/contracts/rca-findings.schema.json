{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCA findings for the companion report",
  "description": "Structured summary of the installed RCA skill's findings for the fishbone and evidence review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "asset_id", "event_id", "ncr", "assessment", "hypotheses", "next_inspection", "limitations"],
  "properties": {
    "site": { "$ref": "#/$defs/text" },
    "asset_id": { "$ref": "#/$defs/text" },
    "event_id": { "$ref": "#/$defs/text" },
    "ncr": {
      "description": "Null means no source NCR was supplied. Approval is copied from the source.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "approval_state"],
          "properties": {
            "reference": { "$ref": "#/$defs/text" },
            "approval_state": { "enum": ["draft", "approved", "rejected"] }
          }
        }
      ]
    },
    "assessment": { "enum": ["draft_investigation", "insufficient_evidence"] },
    "hypotheses": {
      "type": "array",
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "next_inspection": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "rationale", "distinguishes_hypothesis_ids"],
          "properties": {
            "action": { "$ref": "#/$defs/text" },
            "rationale": { "$ref": "#/$defs/text" },
            "distinguishes_hypothesis_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/text" }
            }
          }
        }
      ]
    },
    "limitations": { "type": "array", "items": { "$ref": "#/$defs/text" } }
  },
  "allOf": [
    {
      "if": { "properties": { "assessment": { "const": "draft_investigation" } } },
      "then": { "properties": { "hypotheses": { "minItems": 1 } } },
      "else": { "properties": { "limitations": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "observation"],
      "properties": {
        "source_ref": { "$ref": "#/$defs/text" },
        "observation": { "$ref": "#/$defs/text" }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank", "fishbone_branch", "title", "causal_links", "confirm_test", "rule_out_test"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "rank": { "type": "integer", "minimum": 1, "description": "Equal ranks represent a tie." },
        "fishbone_branch": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "causal_links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "evidence_for", "evidence_against", "limitations"],
            "properties": {
              "claim": { "$ref": "#/$defs/text" },
              "evidence_for": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
              "evidence_against": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
              "limitations": { "type": "array", "items": { "$ref": "#/$defs/text" } }
            },
            "if": { "properties": { "evidence_for": { "maxItems": 0 } } },
            "then": { "properties": { "limitations": { "minItems": 1 } } }
          }
        },
        "confirm_test": { "$ref": "#/$defs/text" },
        "rule_out_test": { "$ref": "#/$defs/text" }
      }
    }
  }
}
